#!/bin/zsh
# workstation-connect — BAĞLANAN Mac'te (MacBook vb.) çalıştırılır.
# 1) Mac mini uyuyorsa Wake-on-LAN sihirli paketi gönderir ve SSH erişilebilir olana kadar bekler,
# 2) bu Mac'in ekran boyutunu algılayıp uzak Mac'i bu çözünürlükte Remote moduna alır,
# 3) Ekran Paylaşımı'nı (vnc://) açar.
#
# Kullanım:  workstation-connect [ssh-host] [--no-vnc] [--no-wake] [--res WxH] [--mac AA:BB:..] [--timeout sn]
#            workstation-connect --setup [ssh-host]   # MAC/IP/yayın adresini uzak Mac'ten alıp yapılandırmaya yazar
#            workstation-connect --wake-only          # yalnızca sihirli paketi gönder
# Yapılandırma: ~/.config/workstation/config  (KEY=değer satırları)
#   HOST=studio              ssh-host (~/.ssh/config adı veya adres)
#   MAC=aa:bb:cc:dd:ee:ff    Mac mini'nin Ethernet MAC adresi (Wake-on-LAN için)
#   BROADCAST=192.168.1.255  yerel ağ yayın adresi (varsayılan 255.255.255.255)
#   VNC_HOST=studio.local    Ekran Paylaşımı adresi (varsayılan HOST)
#   SSH_USER=ayaz            SSH kullanıcı adı (Workstation uygulaması Mac mini'nin duyurusundan yazar)
#   ALT_HOST=mini.tailnet.ts.net  dışarıdan erişim adresi (Tailscale); HOST erişilemezse SSH ve Ekran Paylaşımı için denenir
#   WAKE_TIMEOUT=90          SSH erişilebilir olana kadar azami bekleme (sn)
# Ortam: WS_VNC_HOST → VNC_HOST ile aynı (geriye dönük uyumluluk)
WS_VERSION="@VERSION@"   # build.sh VERSION dosyasından yazar (tek sürüm kaynağı)

# Dil: macOS'un ilk tercih edilen dili Türkçe ise Türkçe, değilse İngilizce (WORKSTATION_LANG=tr|en zorlar).
if [[ -n "${WORKSTATION_LANG:-}" ]]; then [[ "$WORKSTATION_LANG" == tr* ]] && WS_TR=1 || WS_TR=0
else
  _wl=$(/usr/bin/defaults read -g AppleLanguages 2>/dev/null | /usr/bin/sed -n '2p' | /usr/bin/tr -d ' ",')
  [[ "$_wl" == tr* ]] && WS_TR=1 || WS_TR=0
fi
t() { if (( WS_TR )); then print -r -- "$1"; else print -r -- "$2"; fi; }
tn() { if (( WS_TR )); then print -rn -- "$1"; else print -rn -- "$2"; fi; }

CONFIG_DIR="$HOME/.config/workstation"
CONFIG="$CONFIG_DIR/config"
HOST="studio"; MAC=""; BROADCAST="255.255.255.255"; VNC_HOST=""; ALT_HOST=""; SSH_USER=""; WAKE_TIMEOUT=90
if [[ -f "$CONFIG" ]]; then
  # Yalnızca bilinen anahtarları oku (dosya kaynak olarak çalıştırılmaz).
  while IFS='=' read -r k v; do
    v="${v%\"}"; v="${v#\"}"; v="${v%\'}"; v="${v#\'}"
    case "$k" in
      HOST) HOST="$v" ;; MAC) MAC="$v" ;; BROADCAST) BROADCAST="$v" ;;
      VNC_HOST) VNC_HOST="$v" ;; WAKE_TIMEOUT) WAKE_TIMEOUT="$v" ;; ALT_HOST) ALT_HOST="$v" ;; SSH_USER) SSH_USER="$v" ;;
    esac
  done < <(/usr/bin/grep -E '^[A-Z_]+=' "$CONFIG")
fi

OPEN_VNC=1; DO_WAKE=1; RES=""; SETUP=0; WAKE_ONLY=0
while (( $# > 0 )); do
  case "$1" in
    --version|-v) print -r -- "workstation-connect $WS_VERSION"; exit 0 ;;
    --no-vnc) OPEN_VNC=0 ;;
    --no-wake) DO_WAKE=0 ;;
    --res) shift; RES="${1:-}" ;;
    --res=*) RES="${1#--res=}" ;;
    --mac) shift; MAC="${1:-}" ;;
    --mac=*) MAC="${1#--mac=}" ;;
    --timeout) shift; WAKE_TIMEOUT="${1:-90}" ;;
    --setup) SETUP=1 ;;
    --wake-only) WAKE_ONLY=1 ;;
    -h|--help) sed -n '2,18p' "$0"; exit 0 ;;
    -*) t "Bilinmeyen seçenek: $1" "Unknown option: $1" >&2; exit 2 ;;
    *) HOST="$1" ;;
  esac
  shift
done
[[ "$WAKE_TIMEOUT" =~ '^[0-9]+$' ]] || WAKE_TIMEOUT=90
VNC_HOST="${WS_VNC_HOST:-${VNC_HOST:-$HOST}}"

# SSH hedefi: SSH_USER tanımlıysa kullanici@adres (adreste zaten @ varsa dokunulmaz).
tgt() { if [[ -n "$SSH_USER" && "$1" != *@* ]]; then print -r -- "$SSH_USER@$1"; else print -r -- "$1"; fi; }
bare() { print -r -- "${1##*@}"; }
ssh_ok() { /usr/bin/ssh -o BatchMode=yes -o ConnectTimeout=3 "$(tgt "$HOST")" true >/dev/null 2>&1; }

# --- Sihirli paket ------------------------------------------------------------
valid_mac() { [[ "$1" =~ '^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$' ]]; }

send_magic() {
  local mac="${1//[:-]/}" bcast="$2"
  mac="${mac:l}"
  # 1) python3 (yalnızca Command Line Tools kuruluysa; aksi hâlde /usr/bin/python3 kurulum penceresi açar)
  if [[ -x /usr/bin/python3 ]] && /usr/bin/xcode-select -p >/dev/null 2>&1; then
    /usr/bin/python3 - "$mac" "$bcast" <<'PY' && return 0
import socket, sys
mac, bcast = sys.argv[1], sys.argv[2]
pkt = b"\xff" * 6 + bytes.fromhex(mac) * 16
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
for port in (9, 7):
    s.sendto(pkt, (bcast, port))
PY
  fi
  # 2) perl (macOS ile birlikte gelir)
  if [[ -x /usr/bin/perl ]]; then
    /usr/bin/perl -MSocket -e '
      my ($mac, $b) = @ARGV;
      my $pkt = ("\xff" x 6) . (pack("H12", $mac) x 16);
      socket(my $s, PF_INET, SOCK_DGRAM, getprotobyname("udp")) or die "socket: $!";
      setsockopt($s, SOL_SOCKET, SO_BROADCAST, 1) or die "setsockopt: $!";
      my $ip = inet_aton($b) or die "adres: $b";
      for my $p (9, 7) { send($s, $pkt, 0, sockaddr_in($p, $ip)) or die "send: $!"; }
    ' "$mac" "$bcast" && return 0
  fi
  # 3) nc yedeği (yayın adresine izin vermeyebilir)
  if command -v nc >/dev/null 2>&1; then
    local hex="ffffffffffff" i
    for i in {1..16}; do hex+="$mac"; done
    printf "$(echo "$hex" | /usr/bin/sed -E 's/(..)/\\x\1/g')" | nc -u -w1 "$bcast" 9 && return 0
  fi
  return 1
}

wake() {
  if ! valid_mac "$MAC"; then
    t "Wake-on-LAN atlandı: MAC tanımlı değil (workstation-connect --setup $HOST veya --mac)." "Wake-on-LAN skipped: no MAC set (workstation-connect --setup $HOST or --mac)." >&2
    return 1
  fi
  t "→ Wake-on-LAN: $MAC → $BROADCAST" "→ Wake-on-LAN: $MAC → $BROADCAST"
  send_magic "$MAC" "$BROADCAST" || { t "Sihirli paket gönderilemedi." "Couldn't send the magic packet." >&2; return 1; }
}

# --- --setup: değerleri uzak Mac'ten al -----------------------------------------
if (( SETUP )); then
  t "→ $HOST üzerinden ağ bilgisi alınıyor…" "→ Getting network info from $HOST…"
  INFO=$(/usr/bin/ssh -o ConnectTimeout=5 "$(tgt "$HOST")" "/usr/local/bin/workstation netinfo" 2>/dev/null) \
    || { t "SSH başarısız: önce 'ssh $HOST' çalıştığından emin olun (Mac mini uyanık olmalı)." "SSH failed: first make sure 'ssh $HOST' works (the Mac mini must be awake)." >&2; exit 1; }
  R_MAC=$(echo "$INFO" | /usr/bin/awk -F= '$1=="MAC"{print $2}')
  R_BC=$(echo "$INFO" | /usr/bin/awk -F= '$1=="BROADCAST"{print $2}')
  R_HOSTNAME=$(echo "$INFO" | /usr/bin/awk -F= '$1=="HOSTNAME"{print $2}')
  R_TS=$(echo "$INFO" | /usr/bin/awk -F= '$1=="TAILSCALE_NAME"{print $2}')
  [[ -n "$R_TS" ]] || R_TS=$(echo "$INFO" | /usr/bin/awk -F= '$1=="TAILSCALE_IP"{print $2}')
  valid_mac "$R_MAC" || { t "Uzak MAC okunamadı: $INFO" "Couldn't read the remote MAC: $INFO" >&2; exit 1; }
  mkdir -p "$CONFIG_DIR"
  {
    echo "# workstation-connect yapılandırması ($(date '+%Y-%m-%d %H:%M'))"
    echo "HOST=$HOST"
    echo "MAC=$R_MAC"
    echo "BROADCAST=${R_BC:-255.255.255.255}"
    [[ -n "$R_HOSTNAME" ]] && echo "VNC_HOST=$R_HOSTNAME"
    [[ -n "$R_TS" ]] && echo "ALT_HOST=$R_TS"
    echo "WAKE_TIMEOUT=$WAKE_TIMEOUT"
  } > "$CONFIG"
  t "✓ Kaydedildi: $CONFIG" "✓ Saved: $CONFIG"; cat "$CONFIG"
  [[ -z "$R_TS" ]] && t "Not: Mac mini'de Tailscale yok; .local adı ve ev IP'si yalnızca ev ağında çalışır, dışarıdan bağlanamazsın." "Note: no Tailscale on the Mac mini; the .local name and home IP only work on the home network, not from outside."
  exit 0
fi

if (( WAKE_ONLY )); then wake; exit $?; fi

# --- 1) Uyandır ve SSH'yi bekle ----------------------------------------------------
# Dışarıdaysan (.local / ev IP'si çözülmez) Tailscale adresine geç; Tailscale kapalıysa önce aç.
ts_up() { /sbin/ifconfig 2>/dev/null | /usr/bin/awk '/inet 100\./{split($2,a,"."); if (a[2]>=64 && a[2]<=127) f=1} END{exit !f}'; }
if [[ -n "$ALT_HOST" && "$ALT_HOST" != "$HOST" ]] && ! ssh_ok && ! ts_up; then
  for id in io.tailscale.ipn.macsys io.tailscale.ipn.macos; do
    if /usr/bin/open -g -j -b "$id" 2>/dev/null; then
      tn "→ Tailscale açılıyor" "→ Starting Tailscale"
      for i in {1..20}; do ts_up && break; echo -n "."; sleep 1; done; echo
      break
    fi
  done
  ts_up || t "Tailscale bağlı değil: menü çubuğundaki Tailscale simgesinden bağlan." "Tailscale isn't connected: connect from the Tailscale menu bar icon." >&2
fi
if [[ -n "$ALT_HOST" && "$ALT_HOST" != "$HOST" ]] && ! ssh_ok; then
  PRIMARY="$HOST"; HOST="$ALT_HOST"
  if ssh_ok; then
    t "→ $PRIMARY erişilemiyor; Tailscale adresi kullanılıyor: $HOST" "→ $PRIMARY unreachable; using the Tailscale address: $HOST"
  else
    HOST="$PRIMARY"
  fi
fi
if ! ssh_ok; then
  if (( DO_WAKE )) && wake; then
    tn "→ $HOST bekleniyor (en fazla ${WAKE_TIMEOUT} sn)" "→ Waiting for $HOST (up to ${WAKE_TIMEOUT} s)"
    START=$SECONDS; SENT_AGAIN=0
    until ssh_ok; do
      if (( SECONDS - START >= WAKE_TIMEOUT )); then
        echo; t "$HOST ${WAKE_TIMEOUT} sn içinde erişilebilir olmadı. Ethernet/Wake-on-LAN ayarını ve ağı kontrol edin." "$HOST wasn't reachable within ${WAKE_TIMEOUT} s. Check the Ethernet/Wake-on-LAN setting and the network." >&2
        exit 1
      fi
      # 15 sn sonra paketi bir kez daha gönder (ilk paket kaybolmuş olabilir).
      if (( SECONDS - START >= 15 && !SENT_AGAIN )); then send_magic "$MAC" "$BROADCAST" >/dev/null 2>&1; SENT_AGAIN=1; fi
      echo -n "."; sleep 2
    done
    t " uyandı." " awake."
  else
    t "$HOST erişilemiyor; yine de deneniyor…" "$HOST is unreachable; trying anyway…" >&2
  fi
fi

# --- 2) Çözünürlük algıla -----------------------------------------------------------
if [[ -z "$RES" ]]; then
  # Tam ekran Ekran Paylaşımı'nın gerçekten kullandığı alan: ana ekranın nokta boyutu eksi çentik payı
  # (14" MacBook Pro: 1512x982 değil 1512x945; aksi hâlde yanlarda siyah şerit kalır).
  RES=$(/usr/bin/osascript -l JavaScript -e 'ObjC.import("AppKit"); var s = $.NSScreen.mainScreen; var f = s.frame; var t = 0; try { t = s.safeAreaInsets.top } catch (e) {} ; Math.round(f.size.width) + "x" + Math.round(f.size.height - t)' 2>/dev/null)
  # Yedek: system_profiler "UI Looks like: 1512 x 982 @ 120.00Hz"
  if [[ ! "$RES" =~ '^[0-9]+x[0-9]+$' ]]; then
    RES=$(/usr/sbin/system_profiler SPDisplaysDataType 2>/dev/null \
      | /usr/bin/awk -F': ' '/UI Looks like/ {print $2; exit}' \
      | /usr/bin/sed -E 's/^([0-9]+) x ([0-9]+).*/\1x\2/')
  fi
fi
if [[ ! "$RES" =~ '^[0-9]+x[0-9]+$' ]]; then
  t "Ekran boyutu algılanamadı; uzak Mac'teki ön ayar kullanılacak." "Couldn't detect the screen size; the preset on the remote Mac will be used." >&2
  RES=""
fi

# --- 3) Remote + Ekran Paylaşımı ----------------------------------------------------
t "→ $HOST Remote moduna alınıyor${RES:+ ($RES)}…" "→ Switching $HOST to Remote${RES:+ ($RES)}…"
if ! /usr/bin/ssh -o ConnectTimeout=8 "$(tgt "$HOST")" "/usr/local/bin/workstation remote $RES"; then
  t "SSH komutu başarısız. 'ssh $HOST' bağlantısını ve uzak Mac'te Workstation kurulumunu kontrol edin." "SSH command failed. Check the 'ssh $HOST' connection and the Workstation install on the remote Mac." >&2
  exit 1
fi

if (( OPEN_VNC )); then
  # SSH'nin gerçekten ulaştığı adres (evde 192.168…, dışarıda Tailscale 100.x): Ekran Paylaşımı için en güvenilir yedek.
  SSH_ADDR=$(/usr/bin/ssh -o BatchMode=yes -o ConnectTimeout=5 "$(tgt "$HOST")" 'echo $SSH_CONNECTION' 2>/dev/null | /usr/bin/awk '{print $3}')
  vnc_ok() { /usr/bin/nc -z -G 3 "$(bare "$1")" 5900 >/dev/null 2>&1; }
  sleep 3   # sanal ekranın oluşup fiziksel monitörlerin kapanması için
  TARGET=""; TRIED=()
  for h in "$VNC_HOST" "$SSH_ADDR" "$HOST" "$ALT_HOST"; do
    h="$(bare "$h")"
    [[ -n "$h" ]] || continue
    (( ${TRIED[(Ie)$h]} )) && continue
    TRIED+=("$h")
    if vnc_ok "$h"; then TARGET="$h"; break; fi
  done
  if [[ -z "$TARGET" ]]; then
    t "Ekran Paylaşımı (5900) şu adreslerde erişilemiyor: ${TRIED[*]}" "Screen Sharing (5900) isn't reachable at: ${TRIED[*]}" >&2
    t "Mac mini'de Ekran Paylaşımı açık mı? Dışarıdaysan iki Mac'te de Tailscale açık mı? (.local adları yalnızca ev ağında çalışır)" "Is Screen Sharing on on the Mac mini? If you're away, is Tailscale on on both Macs? (.local names only work on the home network)" >&2
    exit 1
  fi
  [[ "$TARGET" != "$VNC_HOST" ]] && t "→ $VNC_HOST erişilemiyor; Ekran Paylaşımı $TARGET üzerinden açılıyor." "→ $VNC_HOST unreachable; opening Screen Sharing via $TARGET."
  /usr/bin/open "vnc://$TARGET"
fi
