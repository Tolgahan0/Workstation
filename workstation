#!/bin/zsh
# Workstation yardımcı komutu (Mac mini / sunucu tarafı).
# Kullanım (yerelde veya SSH ile):
#   workstation remote [WxH | mba13 | mba15 | mbp14 | mbp14n | mbp16 | mbp16n | imac24]
#   workstation sleep | desktop | status | log
#   workstation profile <ad> | fan auto|half|max | keepawake on|off|1h|90m
#   workstation clean [--dry-run | --yes | --auto] [--verbose]   (geliştirici disk temizleyici)
#   workstation netinfo        (Wake-on-LAN için MAC / IP / yayın adresi; workstation-connect --setup kullanır)
# Örnek: ssh studio workstation remote 1512x982
# İstemci Mac'te otomatik çözünürlük için: workstation-connect studio

# Dil: macOS'un ilk tercih edilen dili Türkçe ise Türkçe, değilse İngilizce (WORKSTATION_LANG=tr|en zorlar).
if [[ -n "${WORKSTATION_LANG:-}" ]]; then [[ "$WORKSTATION_LANG" == tr* ]] && WS_TR=1 || WS_TR=0
else
  _wl=$(/usr/bin/defaults read -g AppleLanguages 2>/dev/null | /usr/bin/sed -n '2p' | /usr/bin/tr -d ' ",')
  [[ "$_wl" == tr* ]] && WS_TR=1 || WS_TR=0
fi
t() { if (( WS_TR )); then print -r -- "$1"; else print -r -- "$2"; fi; }
tn() { if (( WS_TR )); then print -rn -- "$1"; else print -rn -- "$2"; fi; }

APP="/Applications/Workstation.app"
BUNDLE_ID="com.tolgahanayaz.workstationmode"

usage() {
  t "Kullanım: workstation remote [WxH|ön ayar] | sleep | desktop | status | log | netinfo" "Usage: workstation remote [WxH|preset] | sleep | desktop | status | log | netinfo"
  t "          workstation profile <ad> | fan auto|half|max | keepawake on|off|1h|3h|90m" "          workstation profile <name> | fan auto|half|max | keepawake on|off|1h|3h|90m"
  t "  remote  → sanal ekran (verilen çözünürlük, yoksa uygulamadaki ön ayar) açık, fiziksel monitörler kapalı" "  remote  → virtual screen on (given resolution, or the preset in the app), physical monitors off"
  t "            ön ayarlar: mba13 1470x956 · mba15 1710x1107 · mbp14 1512x982 · mbp14n 1512x945 · mbp16 1728x1117 · mbp16n 1728x1080 · imac24 2240x1260" "            presets: mba13 1470x956 · mba15 1710x1107 · mbp14 1512x982 · mbp14n 1512x945 · mbp16 1728x1117 · mbp16n 1728x1080 · imac24 2240x1260"
  t "  sleep   → fiziksel monitörler kapalı, düşük güç, sistem uykusuna izin" "  sleep   → physical monitors off, low power, system sleep allowed"
  t "  desktop → fiziksel monitörler açık, sanal ekran kapalı, normal güç" "  desktop → physical monitors on, virtual screen off, normal power"
  t "  status  → geçerli mod" "  status  → current mode"
  t "  log     → son 40 günlük satırı" "  log     → last 40 log lines"
  t "  netinfo → Wake-on-LAN için MAC/IP/yayın adresi (KEY=değer)" "  netinfo → MAC/IP/broadcast address for Wake-on-LAN (KEY=value)"
  t "  profile → kayıtlı çalışma alanı profilini uygula (monitörler + parlaklık + fan)" "  profile → apply a saved workspace profile (monitors + brightness + fans)"
  t "  fan     → fan modu: auto (Otomatik) | half (Yarım) | max (Full Blast)" "  fan     → fan mode: auto | half | max (Full Blast)"
  t "  keepawake → Uyanık tut: on (süresiz) | off | 1h | 3h | 90m" "  keepawake → keep awake: on (indefinitely) | off | 1h | 3h | 90m"
  t "  clean   → disk temizleyici: --dry-run (varsayılan, sadece listeler) | --yes (temizle) | --auto (güvenli küme)" "  clean   → disk cleaner: --dry-run (default, only lists) | --yes (clean) | --auto (safe set)"
  t "            --verbose: atlanan öğeleri ve nedenlerini de göster · scan-app: taramayı uygulamada başlat" "            --verbose: also show skipped items and why · scan-app: start a scan in the app"
}

# URL yolu bileşeni için yüzde kodlama (UTF-8 bayt bayt).
urlencode() {
  local LC_ALL=C s="$1" out="" c i
  for (( i = 1; i <= ${#s}; i++ )); do
    c="${s[i]}"
    if [[ "$c" == [A-Za-z0-9._~-] ]]; then out+="$c"; else out+=$(printf '%%%02X' "'$c"); fi
  done
  print -r -- "$out"
}

open_url() {
  if /usr/bin/open -g "$1"; then t "Workstation → $1 isteği gönderildi." "Workstation → $1 request sent."; else t "Açılamadı: $1" "Couldn't open: $1" >&2; exit 1; fi
}

case "${1:-}" in
  clean)
    shift
    if [[ "${1:-}" == "scan-app" ]]; then open_url "workstation://clean/scan"; exit 0; fi
    [[ -x "$APP/Contents/MacOS/Workstation" ]] || { t "Uygulama bulunamadı: $APP" "App not found: $APP" >&2; exit 1; }
    exec "$APP/Contents/MacOS/Workstation" --clean "$@"
    ;;
  profile)
    [[ -n "${2:-}" ]] || { t "Profil adı gerekli: workstation profile <ad>" "Profile name required: workstation profile <name>" >&2; exit 1; }
    shift
    open_url "workstation://profile/$(urlencode "$*")"
    ;;
  fan)
    case "${2:-}" in
      auto|half|max) open_url "workstation://fan/$2" ;;
      *) t "Kullanım: workstation fan auto|half|max" "Usage: workstation fan auto|half|max" >&2; exit 1 ;;
    esac
    ;;
  keepawake)
    ARG="${2:-on}"
    if [[ "$ARG" =~ '^(on|off|[0-9]+(\.[0-9]+)?[hm]?)$' ]]; then open_url "workstation://keepawake/$ARG"
    else t "Kullanım: workstation keepawake on|off|1h|3h|90m" "Usage: workstation keepawake on|off|1h|3h|90m" >&2; exit 1; fi
    ;;
  remote|sleep|desktop)
    MODE="$1"
    QUERY=""
    CLI_EXTRA=()
    if [[ "$MODE" == "remote" && -n "${2:-}" ]]; then
      ARG="${2:l}"
      ARG="${ARG// /}"
      ARG="${ARG//×/x}"
      if [[ "$ARG" =~ '^[0-9]{3,5}x[0-9]{3,5}$' ]]; then
        QUERY="?res=$ARG";    CLI_EXTRA=(--res "$ARG")
      elif [[ "$ARG" =~ '^(mba13|mba15|mbp14|mbp14n|mbp16|mbp16n|imac24)$' ]]; then
        QUERY="?preset=$ARG"; CLI_EXTRA=(--preset "$ARG")
      else
        t "Geçersiz çözünürlük/ön ayar: $2" "Invalid resolution/preset: $2" >&2; usage; exit 1
      fi
    fi
    if /usr/bin/open -g "workstation://${MODE}${QUERY}"; then
      t "Workstation → ${MODE}${QUERY:+ ($QUERY)} isteği gönderildi." "Workstation → ${MODE}${QUERY:+ ($QUERY)} request sent."
    else
      # Yedek yol: uygulamanın komut satırı argümanı
      "$APP/Contents/MacOS/Workstation" --mode "$MODE" "${CLI_EXTRA[@]}"
    fi
    ;;
  status)
    /usr/bin/defaults read "$BUNDLE_ID" currentMode 2>/dev/null || echo "desktop"
    ;;
  netinfo)
    # Wake-on-LAN için GERÇEK donanım MAC'i gerekir. Sanal / gizlilik adresleri (00:00…, 02:…, yerel yönetimli)
    # atlanır; kablolu (Ethernet) bağlantı önceliklidir, sonra varsayılan rota, en son Wi-Fi.
    usable_mac() {
      local m="${1:l}"
      [[ "$m" =~ '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' ]] || return 1
      [[ "$m" == "00:00:00:00:00:00" || "$m" == "ff:ff:ff:ff:ff:ff" ]] && return 1
      local o=$(( 16#${m[1,2]} ))
      (( (o & 2) == 0 ))   # yerel yönetimli (rastgele/sanal) adres değil
    }
    hw_mac() {
      local m
      m=$(/usr/sbin/networksetup -getmacaddress "$1" 2>/dev/null \
        | /usr/bin/awk '{for(i=1;i<=NF;i++) if ($i ~ /^([0-9a-fA-F][0-9a-fA-F]:){5}[0-9a-fA-F][0-9a-fA-F]$/) {print tolower($i); exit}}')
      usable_mac "$m" && { print -r -- "$m"; return 0 }
      m=$(/sbin/ifconfig "$1" 2>/dev/null | /usr/bin/awk '/ether /{print tolower($2); exit}')
      usable_mac "$m" && { print -r -- "$m"; return 0 }
      return 1
    }
    link_active() { /sbin/ifconfig "$1" 2>/dev/null | /usr/bin/grep -q 'status: active'; }
    DEF=$(/sbin/route -n get default 2>/dev/null | /usr/bin/awk '/interface:/{print $2; exit}')
    # "Port<TAB>aygıt" satırları
    CANDS=("${(@f)$(/usr/sbin/networksetup -listallhardwareports 2>/dev/null \
      | /usr/bin/awk '/^Hardware Port:/{sub(/^Hardware Port: /,""); p=$0} /^Device:/{print p "\t" $2}')}")
    IFACE=""; PORT=""; MAC=""
    try_pick() {   # $1: filtre (wired|default|wifi|any), $2: yalnızca bağlı olanlar (1/0)
      local line port dev m
      for line in "${CANDS[@]}"; do
        port="${line%%$'\t'*}"; dev="${line##*$'\t'}"
        [[ -n "$dev" ]] || continue
        case "$1" in
          wired)   [[ "$port" == *Ethernet* || "$port" == *LAN* ]] || continue
                   [[ "$port" == *Bridge* ]] && continue ;;
          default) [[ "$dev" == "$DEF" ]] || continue ;;
          wifi)    [[ "$port" == *Wi-Fi* || "$port" == *AirPort* ]] || continue ;;
        esac
        [[ "$2" == 1 ]] && ! link_active "$dev" && continue
        m=$(hw_mac "$dev") || continue
        IFACE="$dev"; PORT="$port"; MAC="$m"; return 0
      done
      return 1
    }
    try_pick wired 1 || try_pick default 0 || try_pick wired 0 || try_pick wifi 0 || true
    [[ -n "$IFACE" ]] || IFACE="$DEF"
    # IP/yayın: seçilen arabirimde adres yoksa varsayılan arabirimden al.
    ADDR_IF="$IFACE"
    /sbin/ifconfig "$IFACE" 2>/dev/null | /usr/bin/grep -q 'inet ' || ADDR_IF="$DEF"
    IP=$(/sbin/ifconfig "$ADDR_IF" 2>/dev/null | /usr/bin/awk '/inet /{print $2; exit}')
    BC=$(/sbin/ifconfig "$ADDR_IF" 2>/dev/null | /usr/bin/awk '/inet /{for(i=1;i<=NF;i++) if($i=="broadcast") {print $(i+1); exit}}')
    echo "INTERFACE=$IFACE"
    echo "PORT=$PORT"
    echo "MAC=$MAC"
    echo "IP=$IP"
    echo "BROADCAST=${BC:-255.255.255.255}"
    echo "HOSTNAME=$(/usr/sbin/scutil --get LocalHostName 2>/dev/null).local"
    ;;
  log)
    /usr/bin/tail -n 40 "$HOME/Library/Logs/Workstation.log"
    ;;
  *)
    usage
    exit 1
    ;;
esac
